# Production Multi-Stage Dockerfile for DataPilot FastAPI Backend
FROM python:3.12-slim AS base

# Install system runtime dependencies (curl for readiness health check)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python package dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source code and migration scripts
COPY app ./app
COPY alembic ./alembic
COPY alembic.ini .
COPY pytest.ini .

# Create unprivileged system user and set directory permissions
RUN useradd -m -u 10001 appuser && \
    mkdir -p /app/data/uploads && \
    chown -R appuser:appuser /app

USER appuser

EXPOSE 8000

ENV HOST=0.0.0.0 \
    PORT=8000 \
    WEB_CONCURRENCY=4 \
    STORAGE_LOCAL_DIR=data/uploads

CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers ${WEB_CONCURRENCY:-4}"]
