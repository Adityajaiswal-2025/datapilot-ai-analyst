# Application Environment Configuration
PROJECT_NAME="DataPilot"
VERSION="0.1.0"
API_V1_STR="/api/v1"
DEBUG=False
LOG_LEVEL="INFO"

# Server Configuration
HOST="127.0.0.1"
PORT=8000

# Dataset Ingestion & Resource Safety
MAX_UPLOAD_SIZE_MB=50
MAX_DATASET_ROWS=100000
MAX_DATASET_COLUMNS=500
MAX_DATASETS_IN_MEMORY=50
DATASET_TTL_SECONDS=86400

# Security / CORS Configuration
# Comma-separated origins for production CORS
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Frontend Configuration (used by Vite)
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# LLM Integration Settings
LLM_PROVIDER="openai" # options: openai, google, anthropic, mock
LLM_MODEL_NAME="gpt-4o"
LLM_TEMPERATURE=0.0

# LLM API Keys (Placeholders - DO NOT COMMIT REAL KEYS)
OPENAI_API_KEY="your-openai-api-key-here"
GOOGLE_API_KEY="your-google-api-key-here"
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# Database & Persistence Configuration
# Note: Cloud platforms (Render, Supabase, Neon, Heroku) pass postgres:// or postgresql://.
# DataPilot automatically normalizes unadorned PostgreSQL URLs to postgresql+asyncpg://
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/datapilot"
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="data/uploads"

